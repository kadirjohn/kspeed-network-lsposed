<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_general">

        <SwitchPreferenceCompat
            app:key="enabled"
            app:defaultValue="true"
            app:title="@string/pref_enabled_title"
            app:summary="@string/pref_enabled_summary" />

        <ListPreference
            app:key="mode"
            app:defaultValue="both"
            app:title="@string/pref_mode_title"
            app:entries="@array/mode_entries"
            app:entryValues="@array/mode_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="interval_ms"
            app:defaultValue="1000"
            app:title="@string/pref_interval_title"
            app:entries="@array/interval_entries"
            app:entryValues="@array/interval_values"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="source"
            app:defaultValue="total"
            app:title="@string/pref_source_title"
            app:entries="@array/source_entries"
            app:entryValues="@array/source_values"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_display">

        <ListPreference
            app:key="unit"
            app:defaultValue="auto_bytes"
            app:title="@string/pref_unit_title"
            app:entries="@array/unit_entries"
            app:entryValues="@array/unit_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="show_unit"
            app:defaultValue="true"
            app:title="@string/pref_show_unit_title"
            app:summary="@string/pref_show_unit_summary" />

        <SwitchPreferenceCompat
            app:key="up_on_top"
            app:defaultValue="false"
            app:title="@string/pref_up_top_title"
            app:summary="@string/pref_up_top_summary" />

        <SwitchPreferenceCompat
            app:key="dim_zero"
            app:defaultValue="true"
            app:title="@string/pref_dim_zero_title"
            app:summary="@string/pref_dim_zero_summary" />

        <SwitchPreferenceCompat
            app:key="hide_idle"
            app:defaultValue="false"
            app:title="@string/pref_hide_idle_title"
            app:summary="@string/pref_hide_idle_summary" />

        <SeekBarPreference
            app:key="idle_threshold_kb"
            app:defaultValue="1"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:title="@string/pref_idle_threshold_title"
            app:dependency="hide_idle" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_appearance">

        <SeekBarPreference
            app:key="text_size_sp"
            app:defaultValue="8"
            app:min="5"
            android:max="14"
            app:showSeekBarValue="true"
            app:title="@string/pref_text_size_title" />

        <ListPreference
            app:key="color_mode"
            app:defaultValue="auto"
            app:title="@string/pref_color_mode_title"
            app:entries="@array/color_mode_entries"
            app:entryValues="@array/color_mode_values"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="custom_color"
            app:defaultValue="#FFFFFF"
            app:title="@string/pref_custom_color_title"
            app:summary="@string/pref_custom_color_summary" />

        <EditTextPreference
            app:key="custom_color_ul"
            app:defaultValue="#FFFFFF"
            app:title="@string/pref_custom_color_ul_title"
            app:summary="@string/pref_custom_color_ul_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_surfaces">

        <SwitchPreferenceCompat
            app:key="show_on_shade"
            app:defaultValue="false"
            app:title="@string/pref_show_shade_title"
            app:summary="@string/pref_show_shade_summary" />

        <SwitchPreferenceCompat
            app:key="show_on_lockscreen"
            app:defaultValue="false"
            app:title="@string/pref_show_lockscreen_title"
            app:summary="@string/pref_show_lockscreen_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_about">

        <Preference
            app:key="check_update"
            app:persistent="false"
            app:title="@string/pref_check_update_title" />

        <Preference
            app:key="view_source"
            app:persistent="false"
            app:title="@string/pref_source_repo_title"
            app:summary="github.com/zazaulola/magisk-network-indicator" />

    </PreferenceCategory>

</PreferenceScreen>
