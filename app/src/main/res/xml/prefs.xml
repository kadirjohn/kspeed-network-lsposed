<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="cat_general"
        app:title="@string/cat_general"
        app:icon="@drawable/ic_cat_general"
        app:layout="@layout/preference_category_m3">

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="enabled"
            app:defaultValue="true"
            app:title="@string/pref_enabled_title"
            app:summary="@string/pref_enabled_summary"
            app:icon="@drawable/ic_pref_visibility" />

        <io.github.kadirjohn.kspeed.ChipGroupPreference
            app:key="mode"
            app:defaultValue="both"
            app:title="@string/pref_mode_title"
            app:icon="@drawable/ic_pref_view_agenda" />

        <io.github.kadirjohn.kspeed.ChipGroupPreference
            app:key="interval_ms"
            app:defaultValue="1000"
            app:title="@string/pref_interval_title"
            app:icon="@drawable/ic_pref_timer" />

        <io.github.kadirjohn.kspeed.ChipGroupPreference
            app:key="source"
            app:defaultValue="total"
            app:title="@string/pref_source_title"
            app:icon="@drawable/ic_pref_swap_vert" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_display"
        app:title="@string/cat_display"
        app:icon="@drawable/ic_cat_display"
        app:layout="@layout/preference_category_m3">

        <io.github.kadirjohn.kspeed.ChipGroupPreference
            app:key="unit"
            app:defaultValue="auto_bytes"
            app:title="@string/pref_unit_title"
            app:icon="@drawable/ic_pref_straighten" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="show_unit"
            app:defaultValue="true"
            app:title="@string/pref_show_unit_title"
            app:summary="@string/pref_show_unit_summary"
            app:icon="@drawable/ic_pref_label" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="up_on_top"
            app:defaultValue="false"
            app:title="@string/pref_up_top_title"
            app:summary="@string/pref_up_top_summary"
            app:icon="@drawable/ic_pref_arrow_upward" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="dim_zero"
            app:defaultValue="true"
            app:title="@string/pref_dim_zero_title"
            app:summary="@string/pref_dim_zero_summary"
            app:icon="@drawable/ic_pref_opacity" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="hide_idle"
            app:defaultValue="false"
            app:title="@string/pref_hide_idle_title"
            app:summary="@string/pref_hide_idle_summary"
            app:icon="@drawable/ic_pref_visibility_off" />

        <io.github.kadirjohn.kspeed.MaterialSliderPreference
            app:key="idle_threshold_kb"
            app:defaultValue="1"
            app:min="0"
            android:max="100"
            app:title="@string/pref_idle_threshold_title"
            app:icon="@drawable/ic_pref_speed" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_appearance"
        app:title="@string/cat_appearance"
        app:icon="@drawable/ic_cat_appearance"
        app:layout="@layout/preference_category_m3">

        <io.github.kadirjohn.kspeed.MaterialSliderPreference
            app:key="text_size_sp"
            app:defaultValue="8"
            app:min="5"
            android:max="14"
            app:title="@string/pref_text_size_title"
            app:icon="@drawable/ic_pref_format_size" />

        <io.github.kadirjohn.kspeed.ColorModeSwitchPreference
            app:key="color_mode"
            app:defaultValue="auto"
            app:title="@string/pref_color_mode_auto_title"
            app:summary="@string/pref_color_mode_auto_summary"
            app:icon="@drawable/ic_pref_palette" />

        <io.github.kadirjohn.kspeed.ColorPickerPreference
            app:key="custom_color"
            app:defaultValue="#FFFFFF"
            app:title="@string/pref_custom_color_title"
            app:icon="@drawable/ic_pref_arrow_downward" />

        <io.github.kadirjohn.kspeed.ColorPickerPreference
            app:key="custom_color_ul"
            app:defaultValue="#FFFFFF"
            app:title="@string/pref_custom_color_ul_title"
            app:icon="@drawable/ic_pref_arrow_upward" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="amoled_black"
            app:defaultValue="false"
            app:title="@string/pref_amoled_black_title"
            app:summary="@string/pref_amoled_black_summary"
            app:icon="@drawable/ic_pref_dark_mode" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_surfaces"
        app:title="@string/cat_surfaces"
        app:icon="@drawable/ic_cat_surfaces"
        app:layout="@layout/preference_category_m3">

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="show_on_shade"
            app:defaultValue="false"
            app:title="@string/pref_show_shade_title"
            app:summary="@string/pref_show_shade_summary"
            app:icon="@drawable/ic_pref_notifications" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="show_on_lockscreen"
            app:defaultValue="false"
            app:title="@string/pref_show_lockscreen_title"
            app:summary="@string/pref_show_lockscreen_summary"
            app:icon="@drawable/ic_pref_lock" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/cat_status_icons"
        app:icon="@drawable/ic_cat_display"
        app:layout="@layout/preference_category_m3">

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="hide_statusbar_cellular"
            app:defaultValue="false"
            app:title="@string/pref_hide_statusbar_cellular_title"
            app:summary="@string/pref_hide_statusbar_cellular_summary"
            app:icon="@drawable/ic_pref_visibility_off" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="compact_aosp_vpn_icon"
            app:defaultValue="false"
            app:title="@string/pref_compact_vpn_title"
            app:summary="@string/pref_compact_vpn_summary"
            app:icon="@drawable/ic_vpn_aosp" />

        <io.github.kadirjohn.kspeed.MaterialSwitchPreference
            app:key="compact_hidden_status_icons"
            app:defaultValue="false"
            app:title="@string/pref_compact_hidden_title"
            app:summary="@string/pref_compact_hidden_summary"
            app:icon="@drawable/ic_pref_straighten" />

    </PreferenceCategory>

    <!-- About section: clean card without category outline box -->
    <io.github.kadirjohn.kspeed.AboutCardPreference
        app:key="about_card"
        app:persistent="false" />

</PreferenceScreen>
